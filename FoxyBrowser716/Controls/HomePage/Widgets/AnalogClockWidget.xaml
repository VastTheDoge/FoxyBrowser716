<?xml version="1.0" encoding="utf-8"?>
<homePage:WidgetBase
    x:Class="FoxyBrowser716.Controls.HomePage.Widgets.AnalogClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:homePage="using:FoxyBrowser716.Controls.HomePage"
    mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <!-- drawn on a fixed 200x200 canvas; the Viewbox keeps it round and fully visible at any widget size -->
    <Viewbox Margin="4" Stretch="Uniform">
        <Canvas x:Name="Face" Width="200" Height="200">
            <Ellipse x:Name="Dial" Width="196" Height="196" Canvas.Left="2" Canvas.Top="2" StrokeThickness="3"/>
            <Canvas x:Name="Marks" Width="200" Height="200"/>
            <Line x:Name="HourHand" X1="100" Y1="100" X2="100" Y2="50" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line x:Name="MinuteHand" X1="100" Y1="100" X2="100" Y2="28" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Line x:Name="SecondHand" X1="100" Y1="100" X2="100" Y2="22" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Ellipse x:Name="CenterDot" Width="12" Height="12" Canvas.Left="94" Canvas.Top="94"/>
        </Canvas>
    </Viewbox>
</homePage:WidgetBase>
