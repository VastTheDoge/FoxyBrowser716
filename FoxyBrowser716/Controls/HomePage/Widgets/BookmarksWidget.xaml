<?xml version="1.0" encoding="utf-8"?>
<homePage:WidgetBase
    x:Class="FoxyBrowser716.Controls.HomePage.Widgets.BookmarksWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:homePage="using:FoxyBrowser716.Controls.HomePage"
    mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border x:Name="Card" Margin="4" CornerRadius="10" BorderThickness="2" Padding="4">
        <Grid>
            <!-- tiles reflow into as many columns as fit (no scaling), and the list scrolls when it runs out of room -->
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          SizeChanged="Scroller_OnSizeChanged">
                <Grid x:Name="TilesGrid" VerticalAlignment="Top"/>
            </ScrollViewer>
            <Viewbox x:Name="EmptyView" Stretch="Uniform" MaxHeight="40" Margin="6" Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" Text="No bookmarks yet"/>
            </Viewbox>
        </Grid>
    </Border>
</homePage:WidgetBase>
