<?xml version="1.0" encoding="utf-8"?>
<homePage:WidgetBase
    x:Class="FoxyBrowser716.Controls.HomePage.Widgets.CountdownWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:homePage="using:FoxyBrowser716.Controls.HomePage"
    mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border x:Name="Card" Margin="4" CornerRadius="10" BorderThickness="2" Padding="8">
        <!-- fixed 240px-wide design; unit columns are equal width so the numbers never shift the layout -->
        <Viewbox Stretch="Uniform">
            <StackPanel Width="240" Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="236"/>
                <Grid x:Name="UnitsGrid" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="SecondsColumn" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="DaysText" FontSize="34" FontFamily="Consolas" HorizontalAlignment="Center" Text="0"/>
                        <TextBlock x:Name="DaysLabel" FontSize="11" HorizontalAlignment="Center" Text="days"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HoursText" FontSize="34" FontFamily="Consolas" HorizontalAlignment="Center" Text="00"/>
                        <TextBlock x:Name="HoursLabel" FontSize="11" HorizontalAlignment="Center" Text="hours"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="MinutesText" FontSize="34" FontFamily="Consolas" HorizontalAlignment="Center" Text="00"/>
                        <TextBlock x:Name="MinutesLabel" FontSize="11" HorizontalAlignment="Center" Text="min"/>
                    </StackPanel>
                    <StackPanel x:Name="SecondsPanel" Grid.Column="3">
                        <TextBlock x:Name="SecondsText" FontSize="34" FontFamily="Consolas" HorizontalAlignment="Center" Text="00"/>
                        <TextBlock x:Name="SecondsLabel" FontSize="11" HorizontalAlignment="Center" Text="sec"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="TargetText" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="236"/>
            </StackPanel>
        </Viewbox>
    </Border>
</homePage:WidgetBase>
