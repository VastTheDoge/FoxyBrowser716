<?xml version="1.0" encoding="utf-8"?>
<homePage:WidgetBase
    x:Class="FoxyBrowser716.Controls.HomePage.Widgets.GreetingWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:homePage="using:FoxyBrowser716.Controls.HomePage"
    mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border x:Name="Card" Margin="4" CornerRadius="10" BorderThickness="2" Padding="10,6">
        <!-- the text block is sized by its content, so the Viewbox makes the greeting as large as the widget allows -->
        <Viewbox Stretch="Uniform">
            <StackPanel>
                <TextBlock x:Name="GreetingText" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Viewbox>
    </Border>
</homePage:WidgetBase>
