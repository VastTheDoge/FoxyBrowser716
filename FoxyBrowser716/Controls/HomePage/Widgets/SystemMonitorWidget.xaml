<?xml version="1.0" encoding="utf-8"?>
<homePage:WidgetBase
    x:Class="FoxyBrowser716.Controls.HomePage.Widgets.SystemMonitorWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:homePage="using:FoxyBrowser716.Controls.HomePage"
    mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border x:Name="Card" Margin="4" CornerRadius="10" BorderThickness="2" Padding="8">
        <!-- fixed 220px-wide design with monospace values so the Viewbox scale never jitters as numbers change;
             the metric rows are built in code (CPU goes above the graph, the rest below) -->
        <Viewbox Stretch="Uniform">
            <StackPanel x:Name="MetricsPanel" Width="220" Spacing="6">
                <!-- CPU usage over the last minute, newest sample on the right like Task Manager -->
                <Grid x:Name="GraphHost" Height="48" CornerRadius="4">
                    <Canvas Width="220" Height="48">
                        <Canvas x:Name="GraphGrid"/>
                        <Polygon x:Name="GraphFill"/>
                        <Polyline x:Name="GraphLine" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                    </Canvas>
                </Grid>
            </StackPanel>
        </Viewbox>
    </Border>
</homePage:WidgetBase>
