<?xml version="1.0" encoding="utf-8"?>
<homePage:WidgetBase
    x:Class="FoxyBrowser716.Controls.HomePage.Widgets.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:homePage="using:FoxyBrowser716.Controls.HomePage"
    xmlns:material="using:Material.Icons.WinUI3"
    mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border x:Name="Card" Margin="4" CornerRadius="10" BorderThickness="2" Padding="10,8">
        <!-- fixed 240px-wide design where no text wraps, so the Viewbox scale only changes with Show Forecast.
             The status message sits over the (invisible) weather layout, so loading/error states keep the same size too -->
        <Viewbox Stretch="Uniform">
            <Grid Width="240">
                <StackPanel x:Name="WeatherPanel" Spacing="2" Opacity="0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <material:MaterialIcon x:Name="ConditionIcon" Kind="WeatherPartlyCloudy" Width="52" Height="52" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TemperatureText" Grid.Column="1" FontSize="44" FontWeight="Light" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="--°"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="HighText" FontSize="13" HorizontalAlignment="Right" Text="H --°"/>
                            <TextBlock x:Name="LowText" FontSize="13" HorizontalAlignment="Right" Text="L --°"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ConditionText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="--"/>
                    <TextBlock x:Name="LocationText" FontSize="12" TextTrimming="CharacterEllipsis" Text="--"/>
                    <TextBlock x:Name="DetailsText" FontSize="11" TextTrimming="CharacterEllipsis" Text="--"/>
                    <StackPanel x:Name="ForecastPanel" Spacing="6" Margin="0,6,0,0">
                        <Rectangle x:Name="ForecastDivider" Height="1"/>
                        <Grid x:Name="ForecastGrid" ColumnSpacing="4"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="14" MaxWidth="220" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Viewbox>
    </Border>
</homePage:WidgetBase>
