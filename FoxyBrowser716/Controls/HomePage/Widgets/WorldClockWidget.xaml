<?xml version="1.0" encoding="utf-8"?>
<homePage:WidgetBase
    x:Class="FoxyBrowser716.Controls.HomePage.Widgets.WorldClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:homePage="using:FoxyBrowser716.Controls.HomePage"
    mc:Ignorable="d" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border x:Name="Card" Margin="4" CornerRadius="10" BorderThickness="2" Padding="10,4">
        <!-- the width is fixed in code (label area + the widest time this culture can print) and rows have a constant
             height with a monospace clock, so the Viewbox scale only changes when the zone list or Show Seconds does -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="ContentGrid" Width="280">
                <StackPanel x:Name="RowsPanel"/>
                <TextBlock x:Name="EmptyText" FontSize="14" Margin="0,16" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Visibility="Collapsed" Text="Add time zones in this widget's settings"/>
            </Grid>
        </Viewbox>
    </Border>
</homePage:WidgetBase>
